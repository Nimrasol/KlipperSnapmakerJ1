diff --git a/src/stm32/snapmaker_boot.c b/src/stm32/snapmaker_boot.c
new file mode 100644
index 00000000..ee85f49b
--- /dev/null
+++ b/src/stm32/snapmaker_boot.c
@@ -0,0 +1,118 @@
+// Support for the Snapmaker J1 (gd32f305) factory bootloader
+//
+// Copyright (C) 2026  Nimrasol
+//
+// This file may be distributed under the terms of the GNU GPLv3 license.
+
+#include <string.h> // memcpy
+#include "board/irq.h" // irq_disable
+#include "board/misc.h" // bootloader_request
+#include "internal.h" // FLASH
+#include "sched.h" // DECL_INIT
+
+// The factory bootloader only starts the application if the "update
+// info" header stored in flash has the "app normal" status and the
+// application checksum it contains matches the flash contents.  After
+// an update the bootloader leaves an "update done" status and relies on
+// the application to restore "app normal" (as the stock firmware does
+// on every boot).  Requesting the "update start" status and resetting
+// makes the bootloader wait for a new image from the display.
+
+#define HDR_ADDR 0x080FD000      // Update info header (4KiB flash page)
+#define HDR_SIZE 101             // sizeof(update_packet_info_t)
+#define HDR_STATUS_OFFSET 81
+#define HDR_CHECKSUM_OFFSET 97
+#define STATUS_UPDATE_START 0xAA02
+#define STATUS_APP_NORMAL 0xAA05
+
+// Pages above 512KiB are in the second flash bank, which has its own
+// copy of the key, status, control and address registers
+#define FMC_KEY1  (*(volatile uint32_t *)(FLASH_R_BASE + 0x44))
+#define FMC_STAT1 (*(volatile uint32_t *)(FLASH_R_BASE + 0x4c))
+#define FMC_CTL1  (*(volatile uint32_t *)(FLASH_R_BASE + 0x50))
+#define FMC_ADDR1 (*(volatile uint32_t *)(FLASH_R_BASE + 0x54))
+
+// Checksum used by the bootloader (inverted sum of big-endian words)
+static uint32_t
+snapmaker_checksum(const uint8_t *buf, uint32_t len)
+{
+    uint32_t sum = 0, i;
+    for (i = 0; i + 1 < len; i += 2)
+        sum += (buf[i] << 8) | buf[i + 1];
+    if (len & 1)
+        sum += buf[len - 1];
+    return ~sum;
+}
+
+static void
+flash_wait(void)
+{
+    while (FMC_STAT1 & FLASH_SR_BSY)
+        ;
+    FMC_STAT1 = FLASH_SR_EOP | FLASH_SR_PGERR | FLASH_SR_WRPRTERR;
+}
+
+// Rewrite the header with a new status (the page holds only the header)
+static void
+write_header_status(uint16_t status)
+{
+    uint8_t hdr[HDR_SIZE + 1];
+    memcpy(hdr, (void *)HDR_ADDR, HDR_SIZE);
+    hdr[HDR_SIZE] = 0xff;
+    hdr[HDR_STATUS_OFFSET] = status;
+    hdr[HDR_STATUS_OFFSET + 1] = status >> 8;
+    uint32_t csum = snapmaker_checksum(hdr, HDR_CHECKSUM_OFFSET);
+    memcpy(&hdr[HDR_CHECKSUM_OFFSET], &csum, sizeof(csum));
+
+    irqstatus_t flag = irq_save();
+    FMC_KEY1 = FLASH_KEY1;
+    FMC_KEY1 = FLASH_KEY2;
+    flash_wait();
+    FMC_CTL1 = FLASH_CR_PER;
+    FMC_ADDR1 = HDR_ADDR;
+    FMC_CTL1 = FLASH_CR_PER | FLASH_CR_STRT;
+    flash_wait();
+    FMC_CTL1 = FLASH_CR_PG;
+    volatile uint16_t *dest = (void *)HDR_ADDR;
+    uint32_t i;
+    for (i = 0; i < HDR_SIZE; i += 2) {
+        dest[i / 2] = hdr[i] | (hdr[i + 1] << 8);
+        flash_wait();
+    }
+    FMC_CTL1 = FLASH_CR_LOCK;
+    irq_restore(flag);
+}
+
+static int
+header_is_valid(void)
+{
+    const uint8_t *hdr = (void *)HDR_ADDR;
+    uint32_t csum;
+    memcpy(&csum, &hdr[HDR_CHECKSUM_OFFSET], sizeof(csum));
+    return csum == snapmaker_checksum(hdr, HDR_CHECKSUM_OFFSET);
+}
+
+static uint16_t
+header_status(void)
+{
+    const uint8_t *hdr = (void *)HDR_ADDR;
+    return hdr[HDR_STATUS_OFFSET] | (hdr[HDR_STATUS_OFFSET + 1] << 8);
+}
+
+void
+snapmaker_boot_init(void)
+{
+    if (header_is_valid() && header_status() != STATUS_APP_NORMAL)
+        write_header_status(STATUS_APP_NORMAL);
+}
+DECL_INIT(snapmaker_boot_init);
+
+// Reboot into the factory bootloader and wait for a new image
+void
+snapmaker_bootloader_request(void)
+{
+    if (header_is_valid())
+        write_header_status(STATUS_UPDATE_START);
+    irq_disable();
+    NVIC_SystemReset();
+}
diff --git a/src/stm32/stm32f1.c b/src/stm32/stm32f1.c
index d21cb053..ecabf134 100644
--- a/src/stm32/stm32f1.c
+++ b/src/stm32/stm32f1.c
@@ -58,6 +58,8 @@ gpio_clock_enable(GPIO_TypeDef *regs)
     RCC->APB2ENR;
 }
 
+#if !CONFIG_MACH_GD32F305
+
 // PLL (f103) input: 1 to 25Mhz, output: 16 to 72Mhz
 
 // Main clock setup called at chip startup
@@ -185,6 +187,52 @@ clock_setup_n32g45x(void)
         ;
 }
 
+#else // CONFIG_MACH_GD32F305
+
+  #if CONFIG_CLOCK_REF_FREQ != 25000000 || CONFIG_CLOCK_FREQ != 120000000
+    #error "The gd32f305 is only supported with a 25Mhz crystal at 120Mhz"
+  #endif
+  #if CONFIG_USB
+    #error "USB is not supported on the gd32f305"
+  #endif
+
+// The gd32f305 uses the stm32f105 "connectivity line" clock tree (the
+// main PLL is fed from PREDIV1, which is fed from PLL2), but runs at
+// 120Mhz with a main PLL multiplier the stm32f105 does not support
+static void
+clock_setup_gd32f305(void)
+{
+    // PLL2 = 25Mhz / 5 * 10 = 50Mhz, PREDIV1 = PLL2 / 5 = 10Mhz
+    RCC->CR |= RCC_CR_HSEON;
+    RCC->CFGR2 = ((5 - 1) << RCC_CFGR2_PREDIV2_Pos
+                  | (10 - 2) << RCC_CFGR2_PLL2MUL_Pos
+                  | RCC_CFGR2_PREDIV1SRC | (5 - 1) << RCC_CFGR2_PREDIV1_Pos);
+    RCC->CR |= RCC_CR_PLL2ON;
+    while (!(RCC->CR & RCC_CR_PLL2RDY))
+        ;
+
+    // PLL = PREDIV1 * 12 = 120Mhz
+    uint32_t cfgr = (RCC_CFGR_PLLSRC | (12 - 2) << RCC_CFGR_PLLMULL_Pos
+                     | RCC_CFGR_PPRE1_DIV2 | RCC_CFGR_PPRE2_DIV2
+                     | RCC_CFGR_ADCPRE_DIV8);
+    RCC->CFGR = cfgr;
+    RCC->CR |= RCC_CR_PLLON;
+
+    // Set flash latency
+    FLASH->ACR = (2 << FLASH_ACR_LATENCY_Pos) | FLASH_ACR_PRFTBE;
+
+    // Wait for PLL lock
+    while (!(RCC->CR & RCC_CR_PLLRDY))
+        ;
+
+    // Switch system clock to PLL
+    RCC->CFGR = cfgr | RCC_CFGR_SW_PLL;
+    while ((RCC->CFGR & RCC_CFGR_SWS_Msk) != RCC_CFGR_SWS_PLL)
+        ;
+}
+
+#endif // CONFIG_MACH_GD32F305
+
 
 /****************************************************************
  * GPIO setup
@@ -340,7 +388,9 @@ void
 bootloader_request(void)
 {
     try_request_canboot();
-    if (CONFIG_STM32_FLASH_START_800)
+    if (CONFIG_STM32_SNAPMAKER_BOOTLOADER)
+        snapmaker_bootloader_request();
+    else if (CONFIG_STM32_FLASH_START_800)
         usb_hid_bootloader();
     else if (CONFIG_STM32_FLASH_START_2000)
         usb_stm32duino_bootloader();
@@ -365,10 +415,14 @@ armcm_main(void)
     RCC->APB2ENR = 0;
 
     // Setup clocks
+#if CONFIG_MACH_GD32F305
+    clock_setup_gd32f305();
+#else
     if (CONFIG_MACH_N32G45x)
         clock_setup_n32g45x();
     else
         clock_setup();
+#endif
 
     // Disable JTAG to free PA15, PB3, PB4
     enable_pclock(AFIO_BASE);
